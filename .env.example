# Push notifications: run "python manage.py vapid_keys" and paste the line it prints here
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:your-email@example.com

# Optional, paid: lets Admin create covers with AI (ChatGPT's image engine). See README.
OPENAI_API_KEY=
